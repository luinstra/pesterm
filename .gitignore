# SwiftPM
.build/
.swiftpm/
# Package.resolved IS tracked — we have a real dependency (swift-argument-parser)
# and committing the resolved versions locks the build for anyone cloning this.

# Build artifact assembled by scripts/build-app.sh
pesterm.app/

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Crew (local working context, not for the repo)
.crew/

# Claude Octopus tool state (provider/session metadata, not for the repo)
.claude-octopus/

# Claude Code per-user local settings (the .local suffix means personal, not shared)
.claude/settings.local.json
